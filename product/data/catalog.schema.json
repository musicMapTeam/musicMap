{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Music Map 真实内容基础结构约定",
  "description":"约束基础字段；来源事实、引用完整性、连通性和播放可用性需要另行验证。不得把原型虚构数据当成通过验证的真实数据。",
  "type":"object",
  "required":["graphVersion","artists","tracks","relations","assets","sources"],
  "properties":{
    "graphVersion":{"type":"string","minLength":1},
    "artists":{"type":"array","items":{"$ref":"#/definitions/artist"}},
    "tracks":{"type":"array","items":{"$ref":"#/definitions/track"}},
    "relations":{"type":"array","items":{"$ref":"#/definitions/relation"}},
    "assets":{"type":"array","items":{"$ref":"#/definitions/asset"}},
    "sources":{"type":"array","items":{"$ref":"#/definitions/source"}}
  },
  "definitions":{
    "ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "sourceRefs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "artist":{"type":"object","required":["id","name","sourceRefs","representativeTrackIds"],"properties":{
      "id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"aliases":{"$ref":"#/definitions/ids"},"disambiguation":{"type":"string"},"sourceRefs":{"$ref":"#/definitions/sourceRefs"},"avatarAssetId":{"type":["string","null"]},"representativeTrackIds":{"$ref":"#/definitions/ids"},"styleTags":{"type":"array","items":{"type":"object","required":["name","sourceRefs"],"properties":{"name":{"type":"string"},"sourceRefs":{"$ref":"#/definitions/sourceRefs"}}}}
    }},
    "track":{"type":"object","required":["id","title","artistIds","version","sourceRefs"],"properties":{
      "id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"artistIds":{"allOf":[{"$ref":"#/definitions/ids"},{"minItems":1}]},"version":{"type":"string","minLength":1},"sourceRefs":{"$ref":"#/definitions/sourceRefs"},"previewAssetId":{"type":["string","null"]},"coverAssetId":{"type":["string","null"]}
    }},
    "relation":{"type":"object","required":["id","fromArtistId","toArtistId","type","reason","sourceRefs","verificationStatus","graphVersion"],"properties":{
      "id":{"type":"string","minLength":1},"fromArtistId":{"type":"string","minLength":1},"toArtistId":{"type":"string","minLength":1},"type":{"enum":["cooperation","style"]},"reason":{"type":"string","minLength":1},"sourceRefs":{"$ref":"#/definitions/sourceRefs"},"verificationStatus":{"enum":["pending","verified","rejected"]},"graphVersion":{"type":"string","minLength":1},"evidenceTrackIds":{"$ref":"#/definitions/ids"},"roles":{"type":"array","items":{"type":"object","required":["artistId","trackId","role"],"properties":{"artistId":{"type":"string"},"trackId":{"type":"string"},"role":{"type":"string"}}}}
    },"allOf":[{"if":{"properties":{"type":{"const":"cooperation"}}},"then":{"required":["evidenceTrackIds","roles"],"properties":{"evidenceTrackIds":{"minItems":1},"roles":{"minItems":2}}}}]},
    "asset":{"type":"object","required":["id","type","sourceUrl","sourceRef","licenseOrPermission","availability","checkedAt"],"properties":{
      "id":{"type":"string","minLength":1},"type":{"enum":["image","audio"]},"sourceUrl":{"type":"string"},"sourceRef":{"type":"string"},"servingUrl":{"type":["string","null"]},"licenseOrPermission":{"type":"string","minLength":1},"attribution":{"type":"string"},"availability":{"enum":["pending","available","unavailable"]},"checkedAt":{"type":["string","null"]},"mimeType":{"type":"string"},"durationSeconds":{"type":"number","exclusiveMinimum":0}
    }},
    "source":{"type":"object","required":["id","name","url","status","licenseOrPermission"],"properties":{
      "id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"url":{"type":"string"},"status":{"enum":["pending","verified","rejected"]},"licenseOrPermission":{"type":"string"},"checkedAt":{"type":["string","null"]},"notes":{"type":"string"}
    }}
  }
}
